{
  "name": "@shamoo/bundler",
  "version": "0.1.0-rc.2",
  "description": "Universal lazy-platform esbuild bundling for Shamoo plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/runtime-adapter.ts --format esm,cjs --dts --sourcemap --clean"
  },
  "dependencies": {
    "@shamoo/metadata": "workspace:^",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
