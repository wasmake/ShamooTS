{
  "name": "@shamoo/cli",
  "version": "0.1.0-rc.1",
  "description": "Production CLI and developer tooling for Shamoo plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shamoo": "./dist/cli.js",
    "shamooc": "./dist/shamooc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/shamooc.ts --format esm,cjs --dts --sourcemap --clean"
  },
  "dependencies": {
    "@shamoo/bundler": "workspace:^",
    "@shamoo/compiler": "workspace:^",
    "@shamoo/core": "workspace:^",
    "@shamoo/create-plugin": "workspace:^",
    "@shamoo/metadata": "workspace:^",
    "@shamoo/paper-codegen": "workspace:^",
    "@shamoo/runtime-protocol": "workspace:^",
    "@shamoo/velocity-codegen": "workspace:^"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
