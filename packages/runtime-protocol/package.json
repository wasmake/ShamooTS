{
  "name": "@shamoo/runtime-protocol",
  "version": "0.1.0-rc.2",
  "description": "Versioned Shamoo host-runtime handshake contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean"
  },
  "dependencies": {
    "@shamoo/metadata": "workspace:^",
    "semver": "7.8.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
