{
  "name": "shamoo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript framework foundation for Minecraft Paper and Velocity plugins.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "api:check": "node scripts/check-packages.mjs && node scripts/extract-api.mjs",
    "build": "pnpm clean && pnpm --filter './packages/**' --if-present build",
    "changeset": "changeset",
    "changeset:publish:rc": "changeset publish --tag rc",
    "changeset:version": "changeset version",
    "check": "pnpm format:check && pnpm lint && pnpm codegen:check && pnpm typecheck && pnpm test && pnpm build && pnpm api:check",
    "clean": "node scripts/clean.mjs",
    "codegen:check": "pnpm --filter @shamoo/paper-codegen exec tsx src/cli.ts diff paper - ../../packages/paper-raw/src/generated && pnpm --filter @shamoo/paper-codegen exec tsx src/cli.ts diff paper-nms - ../../packages/paper-nms/src/generated && pnpm --filter @shamoo/paper-codegen exec tsx src/cli.ts diff paper-packets - ../../packages/paper-packets/src/generated && pnpm --filter @shamoo/velocity-codegen exec tsx src/cli.ts diff - ../../packages/velocity-raw/src/generated",
    "contract:check": "node scripts/check-runtime-contract.mjs",
    "docs": "typedoc",
    "examples:build": "pnpm build && node scripts/build-examples.mjs",
    "examples:check": "node scripts/check-compiled-examples.mjs",
    "examples:pack": "node scripts/build-examples.mjs examples/compiled release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:check": "node scripts/check-packages.mjs",
    "release:check": "node scripts/check-release-artifacts.mjs",
    "test": "vitest run",
    "test:packed-cli": "vitest run packages/cli/test/packed-tarball.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.52.11",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.8",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
