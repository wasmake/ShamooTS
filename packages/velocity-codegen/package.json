{
  "name": "@shamoo/velocity-codegen",
  "version": "0.1.0-rc.2",
  "description": "Deterministic Velocity TypeScript binding generator.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "models",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shamoo-velocity-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx src/cli.ts generate - ../../packages/velocity-raw/src/generated && tsup src/index.ts src/cli.ts --format esm,cjs --dts --sourcemap --clean",
    "generate": "tsx src/cli.ts generate"
  },
  "dependencies": {
    "@shamoo/platform-codegen": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
