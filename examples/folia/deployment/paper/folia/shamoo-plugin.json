{
  "name": "folia",
  "displayName": "Shamoo Folia Scheduling",
  "version": "0.1.0",
  "shamoo": {
    "api": "^0.1.0",
    "runtime": "^0.1.0",
    "manifest": 1
  },
  "platforms": {
    "paper": {
      "enabled": true,
      "entrypoint": "paper/index.js",
      "minecraft": "*",
      "paperApi": "*"
    },
    "velocity": {
      "enabled": false
    }
  },
  "dependencies": {
    "required": {},
    "optional": {},
    "loadBefore": [],
    "loadAfter": []
  },
  "node": {
    "builtins": [],
    "filesystem": {
      "read": [],
      "write": []
    },
    "network": false,
    "workers": false,
    "childProcess": false,
    "nativeAddons": false
  },
  "reload": {
    "watch": true,
    "debounceMs": 150,
    "preserveState": false
  }
}
